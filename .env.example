# ==============================================================================
# PlanSafe India — Environment Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# MongoDB Persistence Configuration
# ------------------------------------------------------------------------------
# Optional: If provided, tasks and schedule proposals are persisted to MongoDB.
# If omitted or unreachable, PlanSafe India automatically pivots to its resilient
# in-memory store so hackathon judging and local demos never fail with 500 errors.
MONGODB_URI=mongodb://localhost:27017/plansafe_india
MONGODB_DB_NAME=plansafe_india

# ------------------------------------------------------------------------------
# Meteorological Provider Configuration
# ------------------------------------------------------------------------------
# Open-Meteo High-Resolution Global/India API (Requires no API key for standard use)
WEATHER_PROVIDER_URL=https://api.open-meteo.com/v1/forecast
# Optional: Set to an IMD district weather API endpoint if directly federated
IMD_API_ENDPOINT=

# ------------------------------------------------------------------------------
# Python Recovery & Assessment Engine (Members 3 & 4)
# ------------------------------------------------------------------------------
# The HTTP microservice hosting Member 3's Rule Engine and Member 4's Recovery Engine
PYTHON_SERVICE_URL=http://127.0.0.1:8000
# Timeout in milliseconds for Python engine calls before triggering Next.js parity fallback
PYTHON_SERVICE_TIMEOUT_MS=4000

# ------------------------------------------------------------------------------
# Application & Demo Settings
# ------------------------------------------------------------------------------
# Set to 'true' to enable deterministic demonstration presets (e.g., Raipur Village A)
DEMO_MODE=true
# Default language: 'en' | 'hi'
NEXT_PUBLIC_DEFAULT_LOCALE=en
